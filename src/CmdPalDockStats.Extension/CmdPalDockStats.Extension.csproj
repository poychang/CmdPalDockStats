<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <WindowsSdkPackageVersion>10.0.26100.68-preview</WindowsSdkPackageVersion>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <PlatformTarget Condition="'$(Platform)' == 'x64'">x64</PlatformTarget>
    <PlatformTarget Condition="'$(Platform)' == 'ARM64'">ARM64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <EnableMsixTooling>true</EnableMsixTooling>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxHarvestWinmdRegistration>false</AppxHarvestWinmdRegistration>
    <AppxPackageIdentityName>PoyChang.CmdPalDockStats</AppxPackageIdentityName>
    <AppxPackagePublisher>CN=PoyChang</AppxPackagePublisher>
    <AppxPackageVersion>0.1.0.0</AppxPackageVersion>
    <DefaultLanguage>en-US</DefaultLanguage>
  </PropertyGroup>
  <ItemGroup><Content Include="Assets\*.png" /></ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../CmdPalDockStats.Core/CmdPalDockStats.Core.csproj" />
    <ProjectReference Include="../CmdPalDockStats.Windows/CmdPalDockStats.Windows.csproj" />
    <PackageReference Include="Microsoft.CommandPalette.Extensions" />
    <PackageReference Include="Microsoft.Windows.CsWinRT" />
    <PackageReference Include="Shmuelie.WinRTServer" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.MSIX" PrivateAssets="all" />
    <Manifest Include="$(ApplicationManifest)" />
    <ProjectCapability Include="Msix" />
  </ItemGroup>
</Project>